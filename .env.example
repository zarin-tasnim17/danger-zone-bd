# ==============================================================================
# PRODUCTION DEPLOYMENT REFERENCES
# ==============================================================================
DEPLOYED_BACKEND_URL="https://danger-zone-bd.onrender.com"
DEPLOYED_FRONTEND_URL="https://danger-zone-bd-snowy.vercel.app"

# ==============================================================================
# 1. RENDER DEPLOYMENT (Backend Web Service: danger-zone-bd)
#    Configure these keys in Render Dashboard > Environment Variables
# ==============================================================================
PORT=5000
NODE_ENV=production
CORS_ORIGIN="http://localhost:3000,https://danger-zone-bd-snowy.vercel.app"

# Database Configuration (Supabase PostgreSQL - Pooler & Direct)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Custom Authentication Secrets
JWT_SECRET="your-jwt-secret-key-min-32-chars"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-min-32-chars"

# ==============================================================================
# 2. VERCEL DEPLOYMENT (Frontend Next.js App: danger-zone-bd)
#    Configure these keys in Vercel Dashboard > Project Settings > Environment Variables
# ==============================================================================
NEXT_PUBLIC_APP_URL="https://danger-zone-bd-snowy.vercel.app"
NEXT_PUBLIC_API_URL="https://danger-zone-bd.onrender.com"
NEXT_PUBLIC_SOCKET_URL="https://danger-zone-bd.onrender.com"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_SUPABASE_REF].supabase.co"

# High-Detail Map & Geocoding Configuration
# Available layers: google_streets | google_hybrid | osm
NEXT_PUBLIC_MAP_DEFAULT_LAYER="google_streets"
# Optional: If you obtain an official Google Maps API key later, paste it here.
# Leave empty to use free direct Google tiles + Photon geocoding.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ==============================================================================
# 3. ADMINISTRATOR SEED CREDENTIALS (Backend CLI seeding only; never commit secrets)
#    Generate hash: pnpm --filter api exec node -e "console.log(require('bcrypt').hashSync('<strong-password>', 12))"
# ==============================================================================
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
