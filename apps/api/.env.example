# ==============================================================================
# RENDER DEPLOYMENT CONFIGURATION (apps/api)
# Configure these keys in Render Dashboard > Environment Variables
# ==============================================================================
PORT=5000
NODE_ENV=production
CORS_ORIGIN="http://localhost:3000,https://danger-zone-bd-snowy.vercel.app"

# Database Configuration (Supabase PostgreSQL - Pooler & Direct)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Custom Authentication & Webhook Secrets
JWT_SECRET="your-jwt-secret-key-min-32-chars"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-min-32-chars"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_WEBHOOK_SECRET=""
# Optional: restrict webhook processing to a single bucket name
STORAGE_WEBHOOK_BUCKET=""

# Trusted Media Storage Origins (for /media/presigned-url & /media/confirm validation)
S3_BUCKET="danger-zone-reports"
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_PUBLIC_DOMAIN=""
STORAGE_CDN_URL=""

# Web Push VAPID Configuration
VAPID_PUBLIC_KEY="BEtmSYaZLymwNuQkRyYVz9YxDEE24DnaZps-8EWvh_Q6v9Hy1kTKXUxb1WvOLieZuaPcEKLpEkBD0WBjP49bxNE"
VAPID_PRIVATE_KEY="IOviWuGgONxbR0jH-dGjv2rZsXwXlujciYsl_DKSchM"
VAPID_SUBJECT="mailto:support@safetymap.bd"


# ==============================================================================
# ADMINISTRATOR SEED CREDENTIALS (Backend CLI seeding only; never commit secrets)
# Generate hash: pnpm --filter api exec node -e "console.log(require('bcrypt').hashSync('<strong-password>', 12))"
# ==============================================================================
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

